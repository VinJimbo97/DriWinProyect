# ============================================================
# DriWin — Plantilla de variables de entorno (RAÍZ DEL REPOSITORIO)
# ============================================================
# Este archivo documenta TODAS las variables del monorepo sin datos reales.
# Copiar según el componente que se vaya a levantar:
#
#   Backend  : Copy-Item server-api\.env.example server-api\.env
#   Frontend : Copy-Item app-inicio-windows\.env.example app-inicio-windows\.env
#
# NUNCA commitear los archivos .env reales (ya están excluidos en .gitignore).
# ============================================================

# ------------------------------------------------------------
# A. BACKEND (server-api/.env)
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,https://driwin.vercel.app,app://driwin

# Autenticación de la API (mínimo 32 caracteres aleatorios en producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
API_KEY_READ_ONLY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Azure Database for PostgreSQL Flexible Server (TLS obligatorio)
DATABASE_URL=postgresql://driwin_api:CHANGE_ME@driwin-db-server.postgres.database.azure.com:5432/driwin_catalog?sslmode=require
PGSSLMODE=require
# PostgreSQL local sin TLS (sólo desarrollo): PGSSLMODE=disable y quitar sslmode=require de DATABASE_URL
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# Azure Blob Storage (offloading de binarios)
AZURE_STORAGE_ACCOUNT_NAME=driwinstorage
AZURE_BLOB_ENDPOINT=https://driwinstorage.blob.core.windows.net
AZURE_CONTAINER_APPS=apps
AZURE_CONTAINER_DRIVERS=drivers
AZURE_SAS_TOKEN=

# ------------------------------------------------------------
# B. FRONTEND (app-inicio-windows/.env)
# ------------------------------------------------------------
# Vite sólo expone variables con prefijo VITE_
VITE_API_BASE_URL=http://localhost:3000
# Igual a API_KEY_READ_ONLY del backend. Nunca la API_KEY de escritura.
VITE_API_READ_ONLY_KEY=
