    {
      "name": "05 · Recommendations (negocio)",
      "item": [
        {
          "name": "POST driver recomendado — caso Javier (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ven_id\": \"1002\",\n  \"dev_id\": \"1638\",\n  \"subsys_id\": \"GENERIC\",\n  \"os_environment\": \"Win11_x64\",\n  \"profiles\": [\"Gamer\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/recommendations/driver", "host": ["{{baseUrl}}"], "path": ["recommendations", "driver"] },
            "description": "Caso de uso central: AMD Radeon Vega + perfil Gamer. Debe devolver el Adrenalin 24.9.1 y metadatos de offloading."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Envoltorio { data, meta }', () => {",
                  "  pm.expect(body.data).to.have.all.keys('component', 'recommendation', 'alternatives', 'offloading');",
                  "  pm.expect(body.meta).to.have.property('query_time_ms');",
                  "});",
                  "pm.test('Driver Adrenalin para Gamer', () => {",
                  "  pm.expect(body.data.recommendation.profile_name).to.eql('Gamer');",
                  "  pm.expect(body.data.recommendation.edition_name).to.include('Adrenalin');",
                  "  pm.expect(body.data.recommendation.release_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});",
                  "pm.test('Offloading hacia Azure Blob (el binario no pasa por la API)', () => {",
                  "  pm.expect(body.data.offloading.strategy).to.eql('DIRECT_AZURE_BLOB');",
                  "  pm.expect(body.data.offloading.container).to.eql('drivers');",
                  "  pm.expect(body.data.offloading.binary_traverses_api).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST driver — alias Hito 1 ven/dev/profile (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ven\": \"1002\",\n  \"dev\": \"1638\",\n  \"os_environment\": \"Win11_x64\",\n  \"profile\": \"Creator\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/recommendations/driver", "host": ["{{baseUrl}}"], "path": ["recommendations", "driver"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (compatibilidad Hito 1)', () => pm.response.to.have.status(200));",
