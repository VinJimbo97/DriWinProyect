{
  "name": "app-inicio-windows",
  "private": true,
  "version": "1.0.0",
  "description": "DriWin: instalador de drivers y apps según el perfil del usuario",
  "author": "Equipo DriWin (Vicente Acevedo, Javier Cáceres, Joaquín Castillo)",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"src/**/*.test.ts\" && npm run electron:compile && node --test \"dist-electron/**/*.test.js\"",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && electron . --dev",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "dist:win": "npm run build && npm run electron:compile && electron-builder --win"
  },
  "build": {
    "appId": "cl.driwin.app",
    "productName": "DriWin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DriWin-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DriWin-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
