# ============================================================
# DriWin — Frontend Vite (app-inicio-windows/.env)
# Copiar a: app-inicio-windows/.env   (NUNCA commitear .env)
# ============================================================

# Vite sólo expone variables con prefijo VITE_
# Desarrollo local (server-api en el puerto 3000)
VITE_API_BASE_URL=http://localhost:3000

# Producción (Azure App Service). Descomentar al desplegar:
# VITE_API_BASE_URL=https://driwin-api.azurewebsites.net

# Clave de SÓLO LECTURA: debe ser igual a API_KEY_READ_ONLY de server-api/.env.
# Vite la incrusta en el bundle (es visible para cualquiera), por eso NUNCA
# se pone aquí la API_KEY de escritura. La usa GET /recommendations/apps.
VITE_API_READ_ONLY_KEY=
