# ============================================================
# DriWin API — variables de entorno (Hito 2)
# Copiar a: server-api/.env   (NUNCA commitear .env)
#   Windows:  Copy-Item server-api\.env.example server-api\.env
#   Linux:    cp server-api/.env.example server-api/.env
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,https://driwin.vercel.app,app://driwin

# --- Autenticación de la API ---
# Cambiar en producción (mínimo 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Es la ÚNICA clave de la API (escrituras del catálogo); las lecturas son públicas.
API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Cuentas DriWin (Premium) ---
# Clave maestra para cifrar correos y mensajes de soporte (32 bytes en hex).
# Generar con: openssl rand -hex 32   — NUNCA reutilizar la de producción.
DATA_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
# Intentos de inicio de sesión / registro por IP cada 15 minutos
AUTH_RATE_LIMIT_MAX=10

# --- Límite de peticiones (protección anti-abuso) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# --- Azure Database for PostgreSQL Flexible Server ---
# Formato: postgresql://<usuario>:<password>@<host>:5432/<bd>?sslmode=require
DATABASE_URL=postgresql://driwin_api:CHANGE_ME@driwin-db-server.postgres.database.azure.com:5432/driwin_catalog?sslmode=require
PGSSLMODE=require
# PostgreSQL local sin TLS (sólo desarrollo): PGSSLMODE=disable y quitar sslmode=require de DATABASE_URL
# Verificación del certificado TLS de Azure (dejar true; false sólo con CA corporativa)
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# --- Azure Blob Storage (offloading) ---
# Sólo se necesita la cuenta y el contenedor: el cliente descarga directo.
AZURE_STORAGE_ACCOUNT_NAME=driwinstorage
AZURE_BLOB_ENDPOINT=https://driwinstorage.blob.core.windows.net
AZURE_CONTAINER_APPS=apps
AZURE_CONTAINER_DRIVERS=drivers
# Opcional: token SAS de lectura si los contenedores pasan a privados
AZURE_SAS_TOKEN=
