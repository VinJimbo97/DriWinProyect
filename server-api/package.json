{
  "name": "driwin-server-api",
  "version": "1.0.0",
  "description": "API REST en la nube de DriWin (Node.js + Express + TypeScript + PostgreSQL/Azure) — Hito 2",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:synthetic": "tsx src/scripts/seed-synthetic-users.ts"
  },
  "keywords": [
    "driwin",
    "drivers",
    "bloatware",
    "windows",
    "automation",
    "azure",
    "postgresql",
    "express",
    "typescript"
  ],
  "author": "Equipo DriWin (Vicente Acevedo, Javier Cáceres, Joaquín Castillo)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
